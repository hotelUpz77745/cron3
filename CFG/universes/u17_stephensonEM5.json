{
    "name": "⚡ U17: Stephenson-EM5",
    "description": "Stephenson-EM5 с динамическим фильтром волатильности: микро-ступень L1 (-1.6%, 3% объема) включается только при низкой волатильности (4h ATR <= 5.0%). При высокой волатильности ступень отключается.",
    "signal_heartbeat_tfr": "5m",
    "tp_purpose": "self",
    "avg_free_volume_behavior": "distribute_skip",
    "_avg_free_volume_behavior_modes": {
        "distribute_remaining": "(Распределение) Равномерно делим пропущенный объем между всеми оставшимися неисполненными ступенями сетки.",
        "distribute_nearest": "(Слияние с ближайшим) Объем пропущенных уровней суммируется и переносится в сработавшее колено, а пропущенные помечаются исполненными.",
        "distribute_skip": "(Сжигание объема) Пропущенные уровни помечаются исполненными при отработке ближайшего колена, их объем сгорает и никуда не переносится."
    },
    "super_grid": false,
    "smart_grace": {
        "start_period_sec": 150,
        "shift_interval_sec": [
            5,
            16
        ],
        "_shift_interval_sec_desc": "Рандомизированный сдвиг интервала сердцебиения в секундах от 5 до 16 включительно (равномерный криптографический рандом secrets.SystemRandom с дробными квантами до 0.01s). Размывает границу открытия окна grace period перед закрытием свечи, лишая HFT-алгоритмы возможности вычислять фиксированный тайминг первого сигнального входа.",
        "brownian_noise_factor": [
            3,
            13
        ],
        "increments_card": {
            "==1": 25,
            "==2": 40,
            "==3": 25,
            ">=4": 0
        }
    },
