    "first_order_weight_regime": {
        "mode": "auto_ema",
        "_concept": "«Правило кулака Сильной руки» (Strong Hand Fist Rule)",
        "_desc_mode": "«Правило кулака Сильной руки» (grid_0): регулирует силу стартового входа первого ордера. Варианты: 'bullish' (12% Long / 7% Short — кулак бьет вверх), 'neutral' (9% Long / 9% Short — равновесие во флэте), 'bearish' (7% Long / 12% Short — кулак бьет вниз), 'auto_ema' (динамический выбор по дневной 1d EMA), или 'off' / null (отключение фичи — используются фиксированные базовые объемы из сетки стратегии). Допустимы также числовые эквиваленты: 1 (bullish), 0 (neutral), -1 (bearish).",
        "presets": {
            "bullish": {
                "LONG": 12.0,
                "SHORT": 7.0
            },
            "neutral": {
                "LONG": 9.0,
                "SHORT": 9.0
            },
            "bearish": {
                "LONG": 6.0,
                "SHORT": 13.0
            }
        },
        "_desc_presets": "Веса капитала стартового удара (grid_0 в % от invest_size). ВНИМАНИЕ: «Правило кулака» управляет ИСКЛЮЧИТЕЛЬНО первым ордером (grid_0). Все последующие усредняющие уровни сетки (L1..L6) и их шаги остаются строго неизменными по утвержденной сетке стратегии.",
        "auto_ema": {
            "timeframe": "1d",
            "sma_fast": 10,
            "sma_slow": 30,
            "confirmation_candles": 3,
            "require_rising": true,
            "trend_positive": true,
            "_desc": "Глобальный макро-фильтр по дневным свечам (1d): 10d EMA vs 30d EMA. Быстрая выше медленной (и растет 3 свечи) -> Bullish (12/7), ниже (и падает 3 свечи) -> Bearish (7/12), консолидация/откат -> Neutral (9/9)."
        }
