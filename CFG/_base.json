{
    "name": "_base",
    "description": "Универсальный базовый шаблон со всеми institutional фичами Chita 3.6",
    "min_tp_indent": 0.5,
    "_min_tp_indent_desc": "Общесистемный пол тейк-профита 0.50% per Protocol Rule #11. Конкретные стратегии могут переопределять выше (например 1.05% в Chita 36).",
    "tp_purpose": "self",
    "_tp_purposes_allowed": [
        "self",
        "opposite",
        "both",
        "neutral"
    ],
    "_tp_purpose_desc": "Режимы привязки уровня TP к коленам сетки: 'self' = уровень TP берется строго от своего колена (level_self, изолированный TP); 'opposite' = уровень TP берется от колена противоположной стороны (level_opp); 'both' = берется максимальное колено max(level_self, level_opp); 'neutral' = автономная лестница TP, полностью отвязанная от ступеней сетки усреднения.",
    "avg_free_volume_behavior": "distribute_skip",
    "_avg_free_volume_behavior_modes": {
        "distribute_remaining": "Классика: оставшийся свободный объем пропорционально размазывается по оставшимся ордерам сетки.",
        "distribute_nearest": "Аккумуляция: весь свободный объем наваливается строго на следующий шаг сетки.",
        "distribute_skip": "Chita 3.6 Standard: свободный объем списывается (помечается как исполненный), сетка сохраняет идеальную геометрию без раздувания рисков."
    },
    "_auto_closing_modes_allowed": [
        "trailing_ratchet",
        "toxic",
        "fixed",
        "off"
    ],
    "_auto_closing_mode_desc": "Режимы автоклозера (задаются исключительно в active_strategies на уровне клиента): 'trailing_ratchet' (Fibo trailing ratchet), 'toxic' (динамический токсичный выход), 'fixed' (тейк в USDT), 'off' (выключен).",
    "heartbeat_tfr": "1m",
    "signal_heartbeat_tfr": "15m",
    "super_grid": false,
    "_super_grid_desc": "Флаг адаптивной динамической сетки волатильности: true (включено), false (выключено).",
    "base_order_type": "LIMIT",
    "fallback_order_type": "MARKET",
    "first_order_weight_regime": {
        "mode": "kernel_forecast",
        "_concept": "«Ядерный кулак Сильной руки» (Nadaraya-Watson Non-Parametric Kernel Forecast)",
        "_desc_mode": "«Правило кулака Сильной руки» (grid_0): регулирует силу стартового входа первого ордера. Варианты: 'bullish' (12% Long / 7% Short — кулак бьет вверх), 'neutral' (9% Long / 9% Short — равновесие во флэте), 'bearish' (7% Long / 12% Short — кулак бьет вниз), 'kernel_forecast' (динамический непараметрический прогноз по 1h/1d NWKR без фазового запаздывания), или 'off' / null (отключение фичи — используются фиксированные базовые объемы из сетки стратегии).",
        "presets": {
            "bullish": {
                "LONG": 12.0,
                "SHORT": 7.0
            },
            "neutral": {
                "LONG": 9.0,
                "SHORT": 9.0
            },
            "bearish": {
                "LONG": 7.0,
                "SHORT": 12.0
            }
        },
        "_desc_presets": "Веса капитала стартового удара (grid_0 в % от invest_size). ВНИМАНИЕ: «Правило кулака» управляет ИСКЛЮЧИТЕЛЬНО первым ордером (grid_0). Все последующие усредняющие уровни сетки (L1..L6) и их шаги остаются строго неизменными по утвержденной сетке стратегии.",
        "kernel_forecast": {
            "timeframe": "1h",
            "bandwidth": 8.0,
            "window_size": 30,
            "kernel_type": "rational_quadratic",
            "alpha": 1.0,
            "envelope_multiplier": 1.5,
            "slope_threshold_pct": 0.05,
            "_desc": "Ядерная регрессия Надарая-Ватсона по свечам (1h) с ядром Rational Quadratic (h=8.0, W=30). Оценивает мгновенный наклон Y_hat(t) и положение цены относительно волатильного MAE-конверта: наклон > +0.05% -> Bullish (12/7), наклон < -0.05% -> Bearish (7/12), плоский наклон/конверт -> Neutral (9/9)."
        }
    },
    "smart_grace": {
        "start_period_sec": 150,
        "shift_interval_sec": [
            5,
            16
        ],
        "_shift_interval_sec_desc": "Рандомизированный сдвиг интервала сердцебиения в секундах от 5 до 16 включительно (равномерный криптографический рандом secrets.SystemRandom с дробными квантами до 0.01s). Размывает границу открытия окна grace period перед закрытием свечи, лишая HFT-алгоритмы возможности вычислять фиксированный тайминг первого сигнального входа.",
        "brownian_noise_factor": [
            3,
            13
        ],
        "increments_card": {
            "==1": 25,
            "==2": 40,
            "==3": 25,
            ">=4": 0
        }
    },
